@startuml
left to right direction

skinparam UseCase {
    BackgroundColor LightCyan
    BorderColor DarkSlateGray
    ArrowColor SlateGray
    FontName Arial
}
skinparam Actor {
    BackgroundColor White
    BorderColor DarkSlateGray
    FontName Arial
}
skinparam Rectangle {
    BorderColor DarkSlateGray
    FontStyle bold
}
skinparam ArrowFontSize 11

' ==========================================
' ACTORS
' Player (left): everything triggered by input.
' Time (right): everything that happens on its own.
' ==========================================
actor "Player" as player
actor "Time" as time

' Left out on purpose: the NES password system (replaced by Save /
' Load), the secret bonus items and the bonus stages.
rectangle "Bomberman (NES 1985 rules)" {

    ' Column 1: player goals
    ' 2 extra lives, 1 bomb, fire range 1, stage 1 with a random
    ' layout; the start area is always free. Each stage starts with a
    ' "STAGE n" screen for about 3 s. The main menu shows the top score,
    ' which is kept in browser storage like the saves.
    usecase "Start New Game" as UC_Start
    ' Restores the saved game exactly; it starts paused.
    usecase "Load Saved Game" as UC_Load
    ' Done from the pause menu; replaces the NES password system.
    ' Saves the whole game exactly as it is (stage, board, player,
    ' enemies, bombs, explosions, timer, lives, score).
    usecase "Save Game" as UC_Save
    ' Opens the pause menu (resume, save, quit), only while playing
    ' (not during a death or a "STAGE n" screen). While paused, the
    ' stage, its bombs and its timer stand still.
    usecase "Pause / Resume" as UC_Pause
    ' From the pause menu. The score counts toward the top score,
    ' then the game is dropped and the main menu shows.
    usecase "Quit to Main Menu" as UC_Quit
    ' Hard blocks always block. Soft blocks block unless Wall Pass.
    ' Bombs block unless Bomb Pass; a bomb you just placed under
    ' yourself can still be walked off, but not back onto.
    usecase "Move Bomberman" as UC_Move
    ' Not possible inside a soft block (Wall Pass), on the door, on a
    ' power-up, on a cell that already has a bomb, or when the bomb
    ' limit is reached.
    ' The bomb snaps to the cell under Bomberman's center.
    usecase "Place Bomb" as UC_PlaceBomb
    ' Needs the Detonator power-up; sets off the oldest bomb.
    ' With the Detonator, bombs have no fuse and wait for this.
    usecase "Detonate Bomb Remotely" as UC_Remote

    ' Column 2: consequences
    ' Happens once Bomberman has entered the whole cell.
    usecase "Pick Up Power-up" as UC_PickUp
    ' Happens once Bomberman has entered the whole door cell, with no
    ' enemies alive and no waves still pending. Gives 1 extra life and
    ' leads to the next stage. After stage 50 the game is won: a
    ' "you won" screen with the final score, which counts toward the
    ' top score; a key press returns to the main menu.
    usecase "Exit Stage" as UC_Exit
    ' After a 3 s death animation (the game keeps running), restarts
    ' the stage with a new random layout. All power-ups except Bombs,
    ' Flames and Speed are lost; the score is kept.
    usecase "Lose Life" as UC_LoseLife
    ' Bombed door or power-up: once the flame goes out, the stage's
    ' wave type appears at that cell, filling the stage up to 10
    ' enemies; the power-up is destroyed, the door survives.
    ' Stage time out: all enemies are replaced by 10 Pontans.
    usecase "Spawn Enemy Wave" as UC_Spawn

    ' Column 3: end of game and events driven by time
    ' Shows GAME OVER and the final score, updates the top score;
    ' a key press returns to the main menu.
    usecase "End Game" as UC_EndGame
    ' Each enemy type has its own speed and movement pattern.
    ' Enemies turn around when they reach a bomb.
    usecase "Move Enemies" as UC_MoveEnemies
    ' Blast spreads in 4 directions up to the fire range: destroys soft
    ' blocks (revealing a hidden power-up or the door once they finish
    ' crumbling, and killing anything inside them), kills enemies (each
    ' further kill by the same blast scores more) and detonates other
    ' bombs it reaches (chain reaction). The flame stops at a bomb, but
    ' passes exposed power-ups and the door.
    usecase "Explode Bomb" as UC_Explode
    ' After 200 game seconds (about 1.55 real seconds each), all
    ' enemies are replaced by 10 Pontans.
    ' Play continues; the stage still needs every enemy dead.
    usecase "Run Out of Stage Time" as UC_TimeOut
}

' ==========================================
' ACTOR ASSOCIATIONS (plain lines, as in UML)
' ==========================================
player -- UC_Start
player -- UC_Load
player -- UC_Save
player -- UC_Pause
player -- UC_Quit
player -- UC_Move
player -- UC_PlaceBomb
player -- UC_Remote

UC_MoveEnemies -- time
UC_Explode -- time
UC_TimeOut -- time

' ==========================================
' EXTEND: optional, only when the [condition] holds.
' The arrow points from the extension to the base use case.
' ==========================================
UC_Move <.. UC_PickUp : <<extend>>\n[fully on a power-up's cell]
UC_Move <.. UC_Exit : <<extend>>\n[fully on the door's cell,\nno enemies left or pending]
UC_Move <.. UC_LoseLife : <<extend>>\n[walks into enemy or flame,\nnot protected]

UC_LoseLife <.. UC_EndGame : <<extend>>\n[no lives left]
UC_LoseLife ..> UC_MoveEnemies : <<extend>>\n[enemy reaches player,\nnot invincible]
UC_LoseLife ..> UC_Explode : <<extend>>\n[player in blast, no Flame Pass,\nnot invincible]
UC_Spawn ..> UC_Explode : <<extend>>\n[blast hits exposed\ndoor or power-up]

' ==========================================
' INCLUDE: the base use case always performs the included one.
' The arrow points from the base to the included use case.
' ==========================================
UC_Remote ..> UC_Explode : <<include>>
UC_Spawn <.. UC_TimeOut : <<include>>

' Layout only: keeps "Detonate Bomb Remotely" in the Player column.
UC_Remote -[hidden]- UC_Spawn

@enduml
