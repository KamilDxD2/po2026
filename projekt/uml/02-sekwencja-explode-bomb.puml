@startuml
title Explode Bomb

hide footbox

legend top right
  |<#E6E6E6> View (React / TypeScript) |
  |<#CFE3F7> Controller (Java) |
  |<#D8F0D8> Model (Java) |
endlegend
autonumber

skinparam ParticipantBackgroundColor LightCyan
skinparam ParticipantBorderColor DarkSlateGray
skinparam ActorBackgroundColor White
skinparam ActorBorderColor DarkSlateGray
skinparam ArrowColor SlateGray
skinparam SequenceLifeLineBorderColor SlateGray
skinparam SequenceGroupBorderColor DarkSlateGray
skinparam DefaultFontName Arial
skinparam note {
    BackgroundColor LightYellow
    BorderColor Orange
}

' ==========================================
' Participants, coloured by MVC layer (see legend).
' Board  = static terrain: hard/soft blocks, hidden items, the door.
' Stage  = everything that moves or changes: player, enemies,
'          bombs, explosions.
' "In a cell" = the cell under the creature's center, as in
' "Move Bomberman".
' ==========================================
actor "Time" as time

participant "GameLoop" as view #E6E6E6

participant "GameBridge" as bridge #CFE3F7

participant "game : Game" as game #D8F0D8
participant "stage : Stage" as stage #D8F0D8
participant "bomb : Bomb" as bomb #D8F0D8
participant "explosion : Explosion" as explosion #D8F0D8
participant "board : Board" as board #D8F0D8
participant "enemy : Enemy" as enemy #D8F0D8
participant "player : Player" as player #D8F0D8
participant "EnemyFactory" as factory #D8F0D8

' ==========================================
' One frame in which at least one fuse runs out
' ==========================================
time -> view : next animation frame
view -> bridge : tick(inputMask)
bridge -> game : update(input)
game -> stage : update(input)

note over game, board
  Everything from here until the frame is drawn runs within
  one tick (1/60 s), so the player sees the whole explosion
  appear at once. Order of stage.update(): 1. the player
  ("Move Bomberman", then "Place Bomb" and "Detonate Bomb Remotely"),
  2. bombs (this diagram), 3. the stage timer ("Run Out of Stage
  Time") and enemies ("Move Enemies").
end note

loop for each bomb on the stage
    stage -> bomb : tick()
    bomb --> stage : fuseExpired
    opt fuseExpired and bomb not yet queued
        stage -> stage : explosionQueue.add(bomb)
    end
end
note right of bomb
  Bombs placed while the player has the
  Detonator have no fuse: they explode only
  through "Detonate Bomb Remotely" (which adds
  the oldest bomb to the same queue and continues
  from here) or through a chain reaction. A bomb
  placed into a lingering flame is queued the
  same way ("Place Bomb"). Every way into the
  queue checks "not yet queued", so a bomb can
  never explode twice.
end note

loop while explosionQueue is not empty
    stage -> stage : next = explosionQueue.poll()
    stage -> stage : bombs.remove(next)

    create explosion
    stage -> explosion : new Explosion(next.getCell(), next.getFireRange())
    stage -> explosion : spread(board, bombs)
    explosion -> explosion : flameCells.add(center)
    note right of explosion : The bomb's own cell\nburns too.

    loop for each of 4 directions, up to fireRange cells
        explosion -> board : tileAt(cell)
        board --> explosion : tile
        alt hard block or crumbling block
            explosion -> explosion : stop this direction
        else another bomb on the cell
            explosion -> explosion : hitBombs.add(otherBomb)
            explosion -> explosion : stop this direction
            note right of explosion
              The flame does not pass a bomb;
              it sets it off instead (chain reaction).
            end note
        else soft block
            explosion -> board : crumble(cell)
            explosion -> explosion : brokenBlocks.add(cell)
            explosion -> explosion : stop this direction
            note right of board
              A crumbling block still stops flames.
              After about half a second it disappears
              and exposes its hidden power-up or door,
              so the blast that revealed an item never
              destroys it. Anything inside the block
              (Wall Pass) dies now.
            end note
        else free cell
            explosion -> explosion : flameCells.add(cell)
            note right of explosion
              Exposed power-ups, the door and
              flames of other explosions do not
              stop the flame; flames may overlap.
            end note
        end
    end
    explosion --> stage
    stage -> stage : explosions.add(explosion)
    stage -> explosion : getHitCells()
    explosion --> stage : hitCells (flame cells + broken blocks)

    loop for each living enemy in hitCells
        stage -> enemy : die()
        stage -> enemy : getPoints()
        enemy --> stage : basePoints
        stage -> explosion : scoreKill(basePoints)
        explosion --> stage : points
        stage -> game : onEnemyKilled(points)
        note right of game : Game implements StageListener\nand adds the points to the score
    end
    note over stage, explosion
      Each further kill by the same explosion moves one step up
      the table 100, 200, 400, 800, 1000, 2000, 4000, 8000 (capped
      at 10000), starting at the enemy's own value.
      Example: two Minvos give 800 + 1000.
    end note

    stage -> explosion : getHitBombs()
    explosion --> stage : hitBombs
    loop for each otherBomb in hitBombs (chain reaction)
        opt otherBomb not yet queued
            stage -> stage : explosionQueue.add(otherBomb)
        end
    end

    stage -> explosion : getFlameCells()
    explosion --> stage : flameCells
    loop for each exposed power-up or door in flameCells
        opt power-up
            stage -> board : removeItem(cell)
        end
        stage -> stage : pendingWaves.add(cell)
        note over stage, board
          pendingWaves is a Set of cells, so a door hit by several
          explosions waits for one wave only. The wave appears at
          this cell (the door, or where the power-up was) once no
          flame covers it any more (see the end of the diagram).
          Until then the door stays closed, even with no enemies
          alive. The door survives; a power-up is destroyed.
        end note
    end

    opt player alive and in hitCells
        stage -> player : isFireProof()
        player --> stage : fireProof
        note right of player : true with Flame Pass\nor Mystery invincibility
        opt not fireProof
            stage -> player : die()
            stage -> game : onPlayerHit()
            ref over game, player : Lose Life (continues after the death animation)
        end
    end
end

note over stage, explosion
  Only flameCells linger: anything walking into them
  meanwhile is hit as part of "Move Bomberman" and
  "Move Enemies".
end note

stage --> game
game --> bridge
bridge --> view

view -> bridge : getState()
bridge --> view : tiles, entities, events and game state
view -> view : draw canvas, play sounds

... about half a second later (each tick starts as above) ...

game -> stage : update(input)
stage -> board : tick()
note right of board
  Crumbling blocks finish and disappear,
  exposing their hidden power-up or door.
end note
stage -> explosion : tick()
explosion --> stage : expired
opt expired
    stage -> stage : explosions.remove(explosion)
end
loop for each cell in pendingWaves
    stage -> stage : isBurning(cell)
    note right of stage : Asks every remaining\nexplosion burns(cell).
    opt not burning
        stage -> factory : createWave(stageData.waveType(), cell,\nMAX_ENEMIES - livingEnemyCount())
        factory --> stage : newEnemies (possibly none)
        stage -> stage : enemies.addAll(newEnemies)
        stage -> stage : pendingWaves.remove(cell)
    end
end
note over stage, factory
  One enemy type per stage, enough to fill the stage up to 10
  living enemies (none if there are already 10; the wave is
  still removed, so the door can open later). A wave waits until
  no flame at all covers its cell, so its enemies never appear
  inside the fire of this or any other explosion.
end note

@enduml
