@startuml
title Load Saved Game

hide footbox

legend top right
  |<#E6E6E6> View (React / TypeScript) |
  |<#CFE3F7> Controller (Java) |
  |<#D8F0D8> Model (Java) |
endlegend
autonumber

skinparam ParticipantBackgroundColor LightCyan
skinparam ParticipantBorderColor DarkSlateGray
skinparam ActorBackgroundColor White
skinparam ActorBorderColor DarkSlateGray
skinparam ArrowColor SlateGray
skinparam SequenceLifeLineBorderColor SlateGray
skinparam SequenceGroupBorderColor DarkSlateGray
skinparam DefaultFontName Arial
skinparam note {
    BackgroundColor LightYellow
    BorderColor Orange
}


' ==========================================
' Participants, coloured by MVC layer as in "Explode Bomb" (see legend).
' Reads exactly what "Save Game" wrote, in the same order. Static
' readFrom(in) creates an object; an enemy is created by EnemyFactory
' from its saved type first and then restores its state with
' readState(in), together with its strategy. Includes the extension
' "Delete Save" (from the save list).
' ==========================================
actor "Player" as user

participant "GameLoop" as view #E6E6E6

participant "GameBridge" as bridge #CFE3F7

participant "summary : SaveHeader" as summary #D8F0D8
participant "stageTable : StageTable" as table #D8F0D8
participant "game : Game" as game #D8F0D8
participant "player : Player" as player #D8F0D8
participant "stage : Stage" as stage #D8F0D8
participant "board : Board" as board #D8F0D8
participant "EnemyFactory" as efactory #D8F0D8
participant "strategy : MovementStrategy" as strategy #D8F0D8
participant "enemy : Enemy" as enemy #D8F0D8
participant "bomb : Bomb" as bomb #D8F0D8
participant "explosion : Explosion" as explosion #D8F0D8

note over view, bridge
  The main menu offers "Load Saved Game"
  only when at least one save is stored.
end note

' ==========================================
' 1. The save list
' ==========================================
user -> view : choose "Load Saved Game"
view -> view : read every stored save\n(name from the key, bytes from Base64)
view -> bridge : listSaves(names, saves)
loop for each save
    create summary
    bridge -> summary : SaveHeader.readFrom(stream over this save's bytes)
    note right of summary
      Reads only the header: name, date,
      stage, lives and score. The rest of
      the save is not touched.
    end note
    opt wrong version or broken data (IOException)
        bridge -> bridge : use SaveHeader.damaged(name) for this save
    end
end
bridge -> bridge : sort the summaries with SaveHeader.NEWEST_FIRST\n(a Comparator: newest first, damaged last)
bridge --> view : the summaries as text (JSON)
view -> view : show the save list: name, date, stage,\nscore and lives; damaged saves marked

opt the player deletes a save (Delete Save)
    user -> view : choose "Delete" on a save
    view -> view : ask "Delete this save?"
    opt confirmed
        view -> view : remove "save:" + name from localStorage\nand from the list
    end
    note right of view
      Damaged saves can be deleted but not
      loaded. Deleting the last save closes
      the list and returns to the main menu.
    end note
end

' ==========================================
' 2. Loading the chosen save
' ==========================================
user -> view : pick a save that is not damaged
view -> bridge : loadGame(bytes of that save)
bridge -> bridge : in = new DataInputStream(\nnew ByteArrayInputStream(bytes))

create game
bridge -> game : Game.readFrom(in, stageTable, highScore)
game -> game : header = SaveHeader.readFrom(in)
note right of game : stageNumber, lives and score\ncome from the header.

alt the version matches and the data is complete
    create player
    game -> player : Player.readFrom(in)

    game -> table : get(stageNumber)
    table --> game : stageData

    game -> game : random = new Random()
    create stage
    game -> stage : Stage.readFrom(in, stageData, player, this, random)
    note right of stage : this = Game as StageListener and\nrandom as in "Start New Game".
    stage -> stage : read timeLeft and pendingWaves

    create board
    stage -> board : Board.readFrom(in)

    loop read enemy count, then that many times
        stage -> efactory : readEnemy(in)
        efactory -> efactory : read type
        create strategy
        efactory -> strategy : new strategy for this type
        create enemy
        efactory -> enemy : new Enemy(type, strategy)
        efactory -> enemy : readState(in)
        enemy -> strategy : readState(in)
        efactory --> stage : enemy
        stage -> stage : enemies.add(enemy)
    end

    loop read bomb count, then that many times
        create bomb
        stage -> bomb : Bomb.readFrom(in)
        stage -> stage : bombs.add(bomb)
    end

    loop read explosion count, then that many times
        create explosion
        stage -> explosion : Explosion.readFrom(in)
        stage -> stage : explosions.add(explosion)
    end
    note right of stage
      Same order as "Save Game" wrote it, so
      bombs keep their placement order for
      the Detonator.
    end note

    stage --> game
    game -> game : state = PAUSED
    game --> bridge : game
    bridge -> bridge : replace the current game
    bridge --> view : true
    view -> view : switch to the game, showing the pause menu
    note right of view
      The loaded game starts paused: the player
      sees where they left off and presses Resume.
      No timer runs until then; all timers continue
      from the ticks that were saved.
    end note
else wrong version, broken data or impossible values\n(e.g. stage 0 or 51): IOException
    game --> bridge : error
    bridge --> view : false
    view -> view : show "The save could not be loaded"
    note right of view
      The half-read game is thrown away;
      nothing else changes and the save
      list stays open.
    end note
end

@enduml
