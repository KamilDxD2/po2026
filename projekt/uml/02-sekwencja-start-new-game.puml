@startuml
title Start New Game

hide footbox

legend top right
  |<#E6E6E6> View (React / TypeScript) |
  |<#CFE3F7> Controller (Java) |
  |<#D8F0D8> Model (Java) |
endlegend
autonumber

skinparam ParticipantBackgroundColor LightCyan
skinparam ParticipantBorderColor DarkSlateGray
skinparam ActorBackgroundColor White
skinparam ActorBorderColor DarkSlateGray
skinparam ArrowColor SlateGray
skinparam SequenceLifeLineBorderColor SlateGray
skinparam SequenceGroupBorderColor DarkSlateGray
skinparam DefaultFontName Arial
skinparam note {
    BackgroundColor LightYellow
    BorderColor Orange
}

' ==========================================
' Participants, coloured by MVC layer as in "Explode Bomb" (see legend).
' The "Set Up Stage" group is reused by "Lose Life" (restart with a
' new random layout) and "Exit Stage" (next stage).
' ==========================================
actor "Player" as user

participant "GameLoop" as view #E6E6E6

participant "GameBridge" as bridge #CFE3F7

participant "highScore : HighScore" as high #D8F0D8
participant "stageTable : StageTable" as table #D8F0D8
participant "game : Game" as game #D8F0D8
participant "player : Player" as player #D8F0D8
participant "StageFactory" as sfactory #D8F0D8
participant "board : Board" as board #D8F0D8
participant "EnemyFactory" as efactory #D8F0D8
participant "stage : Stage" as stage #D8F0D8

' ==========================================
' Once, when the app starts: load the 50-stage table (I/O)
' ==========================================
view -> view : fetch("stages.csv")
view -> bridge : loadStages(text)
create table
bridge -> table : StageTable.parse(text)
note right of table
  Reads one line per stage with a BufferedReader (java.io):
  enemy types and counts, hidden power-up type and the
  wave enemy type. Soft blocks: 54 on stage 1, plus 2 for
  each later stage (152 on stage 50). If the file cannot be
  read or parsed, the app shows an error instead of the main
  menu: the game cannot run without it.
end note
bridge --> view
view -> view : read "topScore" from localStorage\n(empty on the very first start)
view -> bridge : loadTopScore(bytes)
create high
bridge -> high : HighScore.readFrom(stream over bytes),\nor new HighScore() if nothing usable is stored
note right of high
  Saveable, like Save Game: the top score survives
  closing the browser. Nothing stored yet, or damaged
  data: the top score starts at 0.
end note
bridge --> view

... later, in the main menu ...

view -> bridge : getTopScore()
bridge -> high : best()
high --> bridge : topScore
bridge --> view : topScore
view -> view : show main menu with the top score

' ==========================================
' The player starts a new game
' ==========================================
user -> view : click "Start New Game"
view -> bridge : startNewGame()

create game
bridge -> game : new Game(stageTable, highScore)
game -> game : lives = 2, score = 0, stageNumber = 1
note right of game : 2 extra lives, as shown\non screen; +1 per cleared stage.

create player
game -> player : new Player()
note right of player : 1 bomb, fire range 1,\nno other power-ups.

group Set Up Stage (also used by "Lose Life" and "Exit Stage")
    game -> table : get(stageNumber)
    table --> game : stageData

    game -> sfactory : create(stageData, player, this, random)
    note right of game
      this = Game as StageListener.
      random = the game's one java.util.Random,
      created with the Game. JUnit tests pass a
      fixed seed to get the same layout.
    end note

    create board
    sfactory -> board : new Board(31, 13)
    note right of board
      29 x 11 playable cells inside a one-cell
      indestructible border. Hard blocks sit on every
      cell whose column and row are both even; every
      other cell starts free. The start cell is (1, 1).
    end note

    sfactory -> sfactory : startArea = top-left cell\n+ the cells right of and below it
    note right of sfactory
      The start area stays free, so the first bomb
      can always be placed and escaped.
    end note

    loop stageData.softBlockCount() times
        sfactory -> board : placeSoftBlock(random free cell outside startArea)
    end

    sfactory -> board : hideDoor(random soft block)
    sfactory -> board : hidePowerUp(another random soft block,\nPowerUp.of(stageData.powerUpType()))
    note right of board : PowerUp.of(type) creates\nthe matching subclass.

    loop for each enemy listed in stageData
        sfactory -> efactory : create(type, random free cell away from startArea)
        efactory --> sfactory : enemy
    end
    note right of efactory
      Gives each enemy its EnemyType
      and MovementStrategy (see
      "Move Enemies").
    end note

    create stage
    sfactory -> stage : new Stage(stageData, board, enemies, player, listener, random)
    stage -> player : respawnAt(start cell)
    note right of stage
      respawnAt puts the player on the start cell
      and makes them alive again (after a death).
      The stage keeps random for Pontan spawn
      cells and hands it to enemies (Arena).
      The timer starts at 200 game seconds
      (about 1.55 real seconds each).
    end note
    sfactory --> game : stage
    game -> game : state = STAGE_INTRO,\nintroTimer = about 3 s
    note right of game
      The view shows a black screen with "STAGE n".
      While it shows, update() only counts introTimer
      down: the stage does not run and its timer does
      not count. Then state = PLAYING.
    end note
end

game --> bridge
bridge --> view
view -> view : switch from the menu to the game\n(starting with the "STAGE 1" screen)
note right of view
  From now on every frame calls
  tick(inputMask), as in "Move Bomberman".
end note

@enduml
